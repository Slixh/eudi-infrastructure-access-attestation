DATABASE_URL="file:./dev.db"

# JWT for invite tokens (GrantModule)
JWT_SECRET="change-me-in-production"
JWT_EXPIRY="7d"

# Issuer identity
ISSUER_DID="did:key:z6Mk..."
ISSUER_PRIVATE_KEY_JWK='{"kty":"OKP","crv":"Ed25519","x":"...","d":"..."}'

# Credential offer base URL (your public server URL)
PUBLIC_BASE_URL="https://your-server.example.com"

# Lock/access endpoint shared secret
ACCESS_SHARED_SECRET="change-me-in-production"

# PID Provider trusted issuer DID (German PID Provider)
