{
  "format": "mso_mdoc",
  "doctype": "urn:eudi:eaa:infrastructure:access:1",
  "display": [
    {
      "name": "Infrastructure Access Attestation",
      "description": "Attests that the holder is authorized to access a specific physical resource.",
      "locale": "en-US"
    }
  ],
  "claims": {
    "urn:eudi:eaa:infrastructure:access:namespace:1": {
      "granted_resource": {
        "mandatory": true,
        "value_type": "string",
        "display": [
          {
            "name": "Granted Resource",
            "description": "Identifier of the physical resource the holder may access",
            "locale": "en-US"
          }
        ]
      },
      "grant_id": {
        "mandatory": true,
        "value_type": "string",
        "display": [
          {
            "name": "Grant ID",
            "description": "Internal grant reference for audit purposes",
            "locale": "en-US"
          }
        ]
      },
      "valid_from": {
        "mandatory": true,
        "value_type": "string",
        "display": [
          {
            "name": "Valid From",
            "locale": "en-US"
          }
        ]
      },
      "valid_until": {
        "mandatory": true,
        "value_type": "string",
        "display": [
          {
            "name": "Valid Until",
            "locale": "en-US"
          }
        ]
      }
    }
  }
}